{
  "schemaVersion": 1,
  "id": "roddy.seafile",
  "name": "Omarseafile",
  "version": "1.2.0",
  "author": "Roddy",
  "description": "A compact, secure Seafile client deeply integrated with Omarchy",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarseafile",
    "description": "Browse, search, transfer, share, and manage Seafile files from Omarchy",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "autoLogin",
        "type": "boolean",
        "label": "Auto-login",
        "default": true
      },
      {
        "key": "foldersFirst",
        "type": "boolean",
        "label": "Folders first",
        "default": true
      }
    ]
  }
}
